# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# Data cache (Yahoo parquet)
_cache/
*.parquet

# Generated figures (keep the demo one if you want; ignored by default)
out_*.png
*.png
!docs/**/*.png

# Papers — do NOT redistribute copyrighted PDFs; keep them local only.
# (the papers/ folder itself is tracked for its README + downloader script)
*.pdf

# Internal handoff/planning doc — kept local, not part of the public repo.
PROJECT_BRIEF.md

# Root-level scratch/work scripts and their outputs — local only.
/_*.py
/_*.out

# Editor/build temp droppings (e.g. build_notebooks.py.tmp.<pid>.<hash>)
*.tmp.*

# Release reproducibility bundles (attached to GitHub Releases, not tracked)
repro_bundle_*.zip

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# MetaTrader / secrets — NEVER commit credentials
*.env
.env
secrets.*
.tools/

# Commit the working paper and its figures (override the global *.pdf ignore)
!studies/01-overnight-anomaly/paper/overnight_alpha.pdf
!studies/01-overnight-anomaly/paper/figures/
!studies/01-overnight-anomaly/paper/figures/*.pdf
